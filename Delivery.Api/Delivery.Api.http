#@baseUrl = http://localhost:5049
@baseUrl = https://localhost:7235

### Get OpenAPI document
GET {{baseUrl}}/openapi/v1.json

### Get CSRF token
GET {{baseUrl}}/api/auth/csrf-token

> {%
    client.test("CSRF token was issued", function() {
        client.assert(response.status === 200, "Expected HTTP 2000");
        client.assert(response.body.requestToken, "Expected requestToken is response");
    });

    client.global.set("csrfToken", response.body.requestToken);
%}

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "test@example.com",
  "password": "StrongPassword123!"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "test@example.com",
  "password": "StrongPassword123!"
}

### Me
GET {{baseUrl}}/api/auth/me
Content-Type: application/json

### Logout
POST {{baseUrl}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}

### Create Restaurant
POST {{baseUrl}}/api/restaraunts
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "name": "Random Restaurant",
  "cnpj": "11222333000181",
  "street": "Rua Altamiro Guimarães",
  "number": "123",
  "complement": "Sala 02",
  "neighborhood": "Centro",
  "city": "Tubarão",
  "state": "SC",
  "postalCode": "88701-300"
}